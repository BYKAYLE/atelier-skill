    "blocked_reason": null,
    "next_step": "product_brief"
  },
  "budget": {
    "agent_call_limit": null,
    "paid_api_limit": "requires_explicit_user_approval",
    "notes": []
  },
  "resume": {
    "count": 0,
    "last_completed_stage": null,
    "notes": []
  }
}
